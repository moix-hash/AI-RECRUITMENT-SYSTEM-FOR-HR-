# Copy to .env and replace all development values before production deployment.
APP_ENV=development
APP_NAME=AI Recruitment Assistant
APP_VERSION=1.0.0
APP_PORT=8501
DATABASE_URL=sqlite:///recruitment_dashboard.db
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-different-long-random-secret
GEMINI_API_KEY=
OPENAI_API_KEY=
MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
LLM_TEMPERATURE=0.2
SESSION_TIMEOUT_MINUTES=60
MAX_UPLOAD_SIZE_MB=20
MAX_RESUME_COUNT=100
LOG_LEVEL=INFO
UPLOAD_DIRECTORY=/app/data/uploads
# Optional, explicitly configured public RSS feed; otherwise 25 demo tech jobs are seeded.
JOB_RSS_FEED_URL=
